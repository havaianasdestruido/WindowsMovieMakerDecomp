// ============================================================================
// Dialog templates
// ============================================================================

IDD_OPTIONS DIALOGEX 0, 0, 320, 200
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Movie Maker Options"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL "General tab", IDS_GENERAL_TAB, "SysTabControl32", WS_TABSTOP, 7, 7, 306, 156
    DEFPUSHBUTTON "OK", IDS_OK, 137, 176, 50, 14
    PUSHBUTTON "Cancel", IDS_CANCEL, 197, 176, 50, 14
    PUSHBUTTON "Apply", IDS_APPLY, 257, 176, 50, 14
END

IDD_ABOUT DIALOGEX 0, 0, 260, 180
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Movie Maker"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT "Windows Live Movie Maker", IDS_APP_TITLE, 60, 10, 140, 12
    LTEXT "Version 2012 (Build 16.4.3528.0331)", IDS_VERSION_STRING, 60, 26, 140, 12
    LTEXT "", IDS_COPYRIGHT, 60, 42, 180, 24
    DEFPUSHBUTTON "OK", IDS_OK, 105, 155, 50, 14
END

IDD_PROGRESS DIALOGEX 0, 0, 280, 60
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION
CAPTION "Progress"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT "", IDS_STATUS_DETAILS, 10, 10, 260, 10
    CONTROL "", IDS_STATUS_PROGRESS, "msctls_progress32", WS_BORDER, 10, 24, 260, 14
    PUSHBUTTON "Cancel", IDS_STATUS_CANCEL, 115, 42, 50, 14
END

// ============================================================================
// Menu resources
// ============================================================================

IDM_MAIN MENUEX
BEGIN
    POPUP "&File", 0
    BEGIN
        MENUITEM "&New project", IDS_NEW_PROJECT
        MENUITEM "&Open project", IDS_OPEN_PROJECT
        MENUITEM "&Save project", IDS_SAVE_PROJECT
        MENUITEM "Save project &as", IDS_SAVE_PROJECT_AS
        MENUITEM SEPARATOR
        MENUITEM "&Publish movie", IDS_PUBLISH
        MENUITEM "Burn a &DVD", IDS_PUBLISH_DVD
        MENUITEM SEPARATOR
        MENUITEM "E&xit", 101
    END
    POPUP "&Edit", 0
    BEGIN
        MENUITEM "&Undo", IDS_UNDO
        MENUITEM "&Redo", IDS_REDO
        MENUITEM SEPARATOR
        MENUITEM "Cu&t", IDS_CUT
        MENUITEM "&Copy", IDS_COPY
        MENUITEM "&Paste", IDS_PASTE
        MENUITEM "&Delete", IDS_DELETE
        MENUITEM "Select &All", IDS_SELECT_ALL
    END
    POPUP "&View", 0
    BEGIN
        MENUITEM "&Home", IDS_HOME_TAB
        MENUITEM "&Animations", IDS_ANIMATIONS_TAB
        MENUITEM "&Visual Effects", IDS_VISUAL_EFFECTS_TAB
        MENUITEM "&Project", IDS_PROJECT_TAB
    END
    POPUP "&Tools", 0
    BEGIN
        MENUITEM "&Options...", IDS_OPTIONS
    END
    POPUP "&Help", 0
    BEGIN
        MENUITEM "Online help (F1)", IDS_HELP
        MENUITEM SEPARATOR
        MENUITEM "Abo&ut Movie Maker", IDS_ABOUT
    END
END

// ============================================================================
// Accelerator tables
// ============================================================================

IDA_MAIN ACCELERATORS
BEGIN
    VK_F1,          IDS_HELP,          VIRTKEY, NOINVERT
    "^N",           IDS_NEW_PROJECT,   ASCII, NOINVERT
    "^O",           IDS_OPEN_PROJECT,  ASCII, NOINVERT
    "^S",           IDS_SAVE_PROJECT,  ASCII, NOINVERT
    "^Z",           IDS_UNDO,          ASCII, NOINVERT
    "^Y",           IDS_REDO,          ASCII, NOINVERT
    "^X",           IDS_CUT,           ASCII, NOINVERT
    "^C",           IDS_COPY,          ASCII, NOINVERT
    "^V",           IDS_PASTE,          ASCII, NOINVERT
    "^A",           IDS_SELECT_ALL,    ASCII, NOINVERT
END

