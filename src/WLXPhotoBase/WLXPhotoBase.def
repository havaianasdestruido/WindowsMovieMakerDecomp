    ; Reference "operator long() const" conversion export. The recreation
    ; exposes the same behavior through the public const member
    ; GetHResult(); the reference name is bound to that symbol so the
    ; export table matches the original byte-for-byte.
    ??BException@Base@@QBEJXZ = ?GetHResult@Exception@Base@@QBEJXZ
    ; Reference private Init(long) member. Bound to the recreation's
    ; public member of the same signature (identical ABI).
    ?Init@Exception@Base@@AAEXJ@Z = ?Init@Exception@Base@@QAEAJXZ
    ?ThreadID@Exception@Base@@QBEKXZ

