#include <windows.h>
#include "resource.h"

// ============================================================================
// RT_MANIFEST -- assembly identity
// ============================================================================
IDR_MANIFEST RT_MANIFEST
BEGIN
    "<?xml version='1.0' encoding='UTF-8' standalone='yes'?>\n"
    "<assembly xmlns='urn:schemas-microsoft-com:asm.v1' manifestVersion='1.0'>\n"
    "  <assemblyIdentity\n"
    "    name='Microsoft.Windows.personalMedia.MovieMaker'\n"
    "    processorArchitecture='x86'\n"
    "    type='win32'\n"
    "    version='16.4.3528.331'/>\n"
    "  <description>Windows Live Movie Maker</description>\n"
    "</assembly>\n"
END

// ============================================================================
// RT_VERSION -- VERSIONINFO
// ============================================================================
IDR_VERSION VERSIONINFO
FILEVERSION     16,4,3528,331
PRODUCTVERSION  16,4,3528,331
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Microsoft Corporation"
            VALUE "FileDescription",  "MovieMakerLang"
            VALUE "FileVersion",      "16.4.3528.0331"
            VALUE "InternalName",     "MovieMakerLang"
            VALUE "LegalCopyright",   "\xa9 2012 Microsoft Corporation. All rights reserved."
            VALUE "OriginalFilename", "MovieMakerLang.DLL"
            VALUE "ProductName",      "Movie Maker"
            VALUE "ProductVersion",   "16.4.3528.0331"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

