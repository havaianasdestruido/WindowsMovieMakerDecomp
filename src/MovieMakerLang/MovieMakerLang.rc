// ============================================================================
// STRINGTABLE -- Error messages
// ============================================================================
STRINGTABLE
BEGIN
    IDS_ERR_CRASH           "Sorry, Movie Maker had to shut down unexpectedly. Please restart it, and then try again. (Error: 0x%1!08X!)"
    IDS_ERR_CMDLINE         "Movie Maker can't use the command line."
    IDS_ERR_FILE_TYPE       "Movie Maker doesn't support the selected file type."
    IDS_ERR_OPEN_PROJECT    "Sorry, Movie Maker can't open this project file. The file might not be compatible with Movie Maker or be corrupted."
    IDS_ERR_FILE_NOT_FOUND  "Movie Maker can't find the media file."
    IDS_ERR_CODEC           "Movie Maker can't use the media file. The file might require a codec that's not installed on this computer or be corrupted."
    IDS_ERR_NETWORK_FOLDER  "Files can't be added directly from a network folder into Movie Maker."
    IDS_ERR_REMOVABLE_DRIVE "Files can't be added directly from a removable drive into Movie Maker."
    IDS_ERR_DRM             "Movie Maker can't use files that are protected with digital rights management."
    IDS_ERR_INTERNET        "Files can't be added directly from the Internet."
    IDS_ERR_AUDIO_CODEC     "The required codec for the audio in the file isn't installed on your computer."
    IDS_ERR_DIRECTSHOW_CODEC "The DirectShow audio or video codec that is required for the file isn't installed on your computer."
    IDS_ERR_OLD_CODEC       "The selected file requires an older audio or video codec that is no longer supported."
    IDS_ERR_MPEG2_CODEC     "An MPEG-2 codec needs to be installed in order to use this file."
END

STRINGTABLE
BEGIN
    IDS_ERR_CANT_START      "Sorry, Movie Maker can't start. Make sure your computer meets the minimum system requirements..."
    IDS_ERR_PUBLISH_PLUGIN  "Movie Maker can't publish your movie on the selected site. Make sure that the plug-in is installed."
    IDS_ERR_FILE_TOO_LARGE  "This file might be too large to successfully upload to %s. You can try shortening it..."
    IDS_ERR_PUBLISH_FAILED  "Your movie wasn't published successfully. Sorry, please try again later."
    IDS_ERR_SERVICE_UNAVAIL "Sorry, the service is not currently available."
    IDS_ERR_NO_PERMISSION   "Sorry, you don't have the appropriate permissions to publish to the location."
    IDS_ERR_SAVE_PERMISSION "You don't have permission to save to this location."
    IDS_ERR_CONTACT_ADMIN   "Contact the administrator to obtain permission."
    IDS_ERR_MISSING_FILES   "A problem has occurred. There are missing or unusable files in your Movie Maker project..."
    IDS_ERR_TIMEOUT         "Sorry, this is taking longer than expected. Do you want to cancel and close Movie Maker?"
    IDS_ERR_DISK_FULL       "Sorry, your movie can't be saved. Free some space on the disk drive..."
    IDS_ERR_OUT_OF_MEMORY   "Out of memory"
    IDS_ERR_INVALID_FORMAT  "Invalid format"
