    ; ---- Base::Exception ------------------------------------------------
    ; Reference ctor is the explicit form (I-prefix). The recreation's
    ; ctor is the public non-explicit QAE form; the reference name is
    ; bound to it (identical ABI: thiscall this+long).
    ??0Exception@Base@@IAE@J@Z = ??0Exception@Base@@QAE@J@Z
